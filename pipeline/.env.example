# Copia a .env y ajusta. Nunca credenciales en el repositorio.
SEED=42
OUTCOME_MONTHS=6            # ventana de resultado (3 ó 6)
TARGET_PERCENTILE=0.85      # umbral del target (0.85 ó 0.90)
HOLDOUT_MONTHS=2
# Base de datos servida: SQLite por defecto; en docker-compose se usa PostgreSQL
# DATABASE_URL=postgresql+psycopg2://embat:embat@postgres:5432/embat
POSTGRES_USER=embat
POSTGRES_PASSWORD=embat
POSTGRES_DB=embat
# API
API_URL=http://localhost:8000
# API_KEY=cambia-esto        # si se define, la API exige la cabecera X-API-Key
RATE_LIMIT_PER_MIN=240
